{
  "compilerOptions": {
    "target": "ES2022",
    "module": "es2022",
    "moduleResolution": "node",

    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "shared/**/*",
    "apps/cli/**/*",
    "apps/web-server/src/shared/controlled-english/**/*.ts",
    "apps/web-server/src/shared/readable-tests/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
